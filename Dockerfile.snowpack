# Dockerfile.snowpack — Multi-stage build for SNOWPACK C++ + COSIPY Python
# Stage 1: Build SNOWPACK + MeteoIO from source (LGPL v3, zero cost)
# Stage 2: Slim runtime with Python + COSIPY + SNOWPACK binaries
#
# Phase 0.5 hardening:
#   - Pinned revisions (operator must supply verified commit hashes)
#   - Quoted pip version constraints
#   - CMD fails if snowpack --version fails (no false-green)
#   - No permissive || true installation paths
#
# Build:  docker build -f Dockerfile.snowpack \
#           --build-arg METEOIO_COMMIT=<40-hex> \
#           --build-arg SNOWPACK_COMMIT=<40-hex> \
#           --build-arg TOOLCHAIN_MANIFEST_ID=<approved-id> \
#           --build-arg UBUNTU_BASE_DIGEST=sha256:<64-hex> \
#           --build-arg PYTHON_BASE_DIGEST=sha256:<64-hex> \
#           -t avalanche-snowpack .
# Run:    docker run --rm avalanche-snowpack python3 -c "from cosipy.cpkernel import cosipy_core; print('OK')"
# Verify: docker run --rm avalanche-snowpack snowpack --version

# =============================================================================
# Phase 0.5: Pinned revisions — operator must supply verified commit hashes.
# These are build args with no default; the build fails if they are not set.
# =============================================================================
ARG METEOIO_COMMIT
ARG SNOWPACK_COMMIT
ARG TOOLCHAIN_MANIFEST_ID
ARG UBUNTU_BASE_IMAGE=ubuntu:22.04
ARG UBUNTU_BASE_DIGEST
ARG PYTHON_BASE_IMAGE=python:3.12-slim
ARG PYTHON_BASE_DIGEST

# =============================================================================
# Stage 1: Builder — compile SNOWPACK + MeteoIO from source
# =============================================================================
# Both base images are digest-pinned at build time. The digest args are
# required; tag-only or floating base images cannot build a release image.
FROM ${UBUNTU_BASE_IMAGE}@${UBUNTU_BASE_DIGEST} AS builder

ARG METEOIO_COMMIT
ARG SNOWPACK_COMMIT
ARG TOOLCHAIN_MANIFEST_ID
ARG UBUNTU_BASE_DIGEST

ENV DEBIAN_FRONTEND=noninteractive

# C0.34: validate exact immutable inputs inside the Dockerfile before any clone.
RUN printf '%s\n' "$METEOIO_COMMIT" | grep -Eq '^[0-9a-fA-F]{40}$' || \
      (echo "ERROR: METEOIO_COMMIT must be an exact 40-character commit hash" && exit 1)
RUN printf '%s\n' "$SNOWPACK_COMMIT" | grep -Eq '^[0-9a-fA-F]{40}$' || \
      (echo "ERROR: SNOWPACK_COMMIT must be an exact 40-character commit hash" && exit 1)
RUN test -n "$TOOLCHAIN_MANIFEST_ID" || \
      (echo "ERROR: TOOLCHAIN_MANIFEST_ID is required for runtime attestation" && exit 1)
RUN printf '%s\n' "$UBUNTU_BASE_DIGEST" | grep -Eq '^sha256:[0-9a-fA-F]{64}$' || \
      (echo "ERROR: UBUNTU_BASE_DIGEST must be sha256:<64 hex>" && exit 1)

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    cmake \
    g++ \
    gcc \
    git \
    libproj-dev \
    libstdc++-11-dev \
    make \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Phase 0.5: Clone MeteoIO at pinned commit (not floating --depth 1 head)
RUN git clone https://code.wsl.ch/snow-models/meteoio.git meteoio && \
    cd meteoio && git checkout "$METEOIO_COMMIT" && \
    echo "MeteoIO pinned to: $(git rev-parse HEAD)"

# Build MeteoIO (static, minimal plugins)
RUN mkdir -p build/meteoio && \
    cmake -S meteoio -B build/meteoio \
        -DCMAKE_INSTALL_PREFIX=/opt/snowpack \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_SKIP_RPATH=ON \
        -DCMAKE_SKIP_INSTALL_RPATH=ON \
        -DBUILD_SHARED_LIBS=OFF \
        -DBUILD_STATIC_LIBS=ON \
        -DPLUGIN_PNG=OFF \
        -DPLUGIN_ARCGIS=OFF \
        -DPLUGIN_GDAL=OFF \
    && cmake --build build/meteoio --parallel "$(nproc)" \
    && cmake --install build/meteoio

# Phase 0.5: Clone SNOWPACK at pinned commit (not floating --depth 1 head)
RUN git clone https://code.wsl.ch/snow-models/snowpack.git snowpack && \
    cd snowpack && git checkout "$SNOWPACK_COMMIT" && \
    echo "SNOWPACK pinned to: $(git rev-parse HEAD)"

# Build SNOWPACK (static, with MeteoIO)
RUN mkdir -p build/snowpack && \
    cmake -S snowpack -B build/snowpack \
        -DCMAKE_INSTALL_PREFIX=/opt/snowpack \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_SKIP_RPATH=ON \
        -DCMAKE_SKIP_INSTALL_RPATH=ON \
        -DBUILD_SHARED_LIBS=OFF \
        -DBUILD_STATIC_LIBS=ON \
        -DMETEOIO_ROOT=/opt/snowpack \
    && cmake --build build/snowpack --parallel "$(nproc)" \
    && cmake --install build/snowpack

# Phase 0.5: verify the snowpack executable was built (not just static libs)
RUN test -f /opt/snowpack/bin/snowpack || (echo "ERROR: snowpack binary not found after build" && exit 1)
# G11: Fail closed on version check — don't allow builds with broken binaries
RUN /opt/snowpack/bin/snowpack --version 2>/dev/null \
    || (echo "ERROR: snowpack --version failed — binary may be broken" && exit 1)
# C0.18: Embed runtime-verifiable toolchain identity before leaving builder stage.
RUN set -eu; \
    binary_sha256="$(sha256sum /opt/snowpack/bin/snowpack | awk '{print $1}')"; \
    binary_version="$(/opt/snowpack/bin/snowpack --version 2>&1 | tr '\r\n\t' '   ' | tr -s ' ' | sed 's/^ *//; s/ *$//')"; \
    compiler_version="$(g++ --version | head -n 1)"; \
    cmake_version="$(cmake --version | head -n 1)"; \
    printf '{"schema_version":"snowpack_toolchain_manifest_v1","toolchain_id":"%s","meteoio_commit":"%s","snowpack_commit":"%s","binary_path":"/opt/snowpack/bin/snowpack","binary_sha256":"%s","binary_version":"%s","compiler":"%s","cmake":"%s"}\n' \
      "$TOOLCHAIN_MANIFEST_ID" "$METEOIO_COMMIT" "$SNOWPACK_COMMIT" "$binary_sha256" "$binary_version" "$compiler_version" "$cmake_version" \
      > /opt/snowpack/toolchain-manifest.json

# =============================================================================
# Stage 2: Runtime — slim Python image with SNOWPACK binaries and the
# minimal native POC orchestration dependencies. COSIPY remains an optional
# research lane and is not pulled into the native release image.
# =============================================================================
FROM ${PYTHON_BASE_IMAGE}@${PYTHON_BASE_DIGEST} AS runtime

ARG PYTHON_BASE_DIGEST
RUN printf '%s\n' "$PYTHON_BASE_DIGEST" | grep -Eq '^sha256:[0-9a-fA-F]{64}$' || \
      (echo "ERROR: PYTHON_BASE_DIGEST must be sha256:<64 hex>" && exit 1)

# Copy SNOWPACK binaries and libraries from builder
COPY --from=builder /opt/snowpack/bin/ /opt/snowpack/bin/
COPY --from=builder /opt/snowpack/lib/ /opt/snowpack/lib/
COPY --from=builder /opt/snowpack/include/ /opt/snowpack/include/
COPY --from=builder /opt/snowpack/toolchain-manifest.json /opt/snowpack/toolchain-manifest.json

# Set SNOWPACK environment
ENV SNOWPACK_HOME=/opt/snowpack
ENV LD_LIBRARY_PATH=/opt/snowpack/lib:${LD_LIBRARY_PATH}
ENV PATH=/opt/snowpack/bin:${PATH}

# C0.34: Install the native POC's hash-pinned Python dependency lock.
# No version ranges or unverified package downloads are allowed in a release image.
COPY backend/locks/snowpack-native-poc-py312.txt /tmp/snowpack-native-poc-py312.txt
RUN pip install --no-cache-dir --require-hashes -r /tmp/snowpack-native-poc-py312.txt

# Copy the native runtime config files.
COPY config.toml /app/config.toml
COPY constants.toml /app/constants.toml

WORKDIR /app

# Phase 0.5: Default CMD verifies SNOWPACK and the native orchestration runtime.
# Fails (non-zero exit) if snowpack --version fails — no false-green.
# Uses a script file to avoid nested quote issues in shell -c.
RUN echo '#!/bin/sh' > /app/verify.sh && \
    echo 'python3 -c "import numpy, requests, yaml; print('"'"'NATIVE_POC_RUNTIME_OK'"'"')"' >> /app/verify.sh && \
    echo 'snowpack --version' >> /app/verify.sh && \
    echo 'echo SNOWPACK_BINARY_VERIFIED' >> /app/verify.sh && \
    chmod +x /app/verify.sh
CMD ["/app/verify.sh"]
