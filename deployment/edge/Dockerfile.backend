FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ gdal-bin libgdal-dev libgeos-dev libproj-dev \
    && rm -rf /var/lib/apt/lists/*

ENV GDAL_VERSION=3.6

WORKDIR /app

COPY pyproject.toml pyproject.toml 2>/dev/null || true
COPY requirements.txt requirements.txt 2>/dev/null || true
COPY backend/ backend/
COPY config/ config/
COPY constants.toml constants.toml 2>/dev/null || true

RUN pip install --no-cache-dir numpy && \
    pip install --no-cache-dir -r requirements.txt 2>/dev/null || \
    pip install --no-cache-dir \
        rasterio pyshp whitebox requests \
        scikit-learn xgboost \
        psycopg2-binary redis \
        pydantic

CMD ["python", "-m", "backend.daily_inference", "--help"]
