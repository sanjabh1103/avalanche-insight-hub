# Environment variables for local development.
# Copy this file to .env.local and adjust as needed:
#   cp .env.local.example .env.local
#
# These values are PUBLIC (anon/publishable key, not service role).
# The Supabase publishable key is safe to expose in client-side code.

# Supabase project URL (public)
VITE_SUPABASE_URL=https://eyyellmffzzujyssaayb.supabase.co

# Supabase publishable (anon) key — safe for client-side use (public)
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-the-canonical-project-publishable-key

# Optional: Bypass role access gate for local development.
# When true, the knowledge graph is accessible without scientist credentials.
# Has NO effect in production builds (vite build strips this).
# VITE_DEMO_MODE=true
